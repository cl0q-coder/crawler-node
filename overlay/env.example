# Example environment — PLACEHOLDER VALUES ONLY.
# Copy to .env (git-ignored, lives in the PRIVATE overlay repo only) and
# fill in real values. Nothing in this file is a real credential.
#
# The node refuses to start if any required variable is unset or still
# holds a CHANGEME placeholder (see load-env.sh).

# Postgres the node writes crawl data to.
CL0Q_DB_DSN=postgres://CHANGEME:CHANGEME@db-host.example.invalid:5432/cl0q?sslmode=require

# Public base URL of this node's operator contact page (bot politeness).
CL0Q_OPERATOR_CONTACT=https://operator.example.invalid/contact

# 0 (default): the node only talks HTTPS to cl0q. Set to 1 only for
# loopback testing — never in prod.
CL0Q_NODE_ALLOW_HTTP=0

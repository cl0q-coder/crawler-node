# Copy to .env and fill in. docker compose reads it; never commit .env.

# --- your node (from enrollment) ---
# The node id cl0q gave you. It is sent in every request's User-Agent ("operator=<id>") so site owners
# can identify your node. 2-32 characters: a-z, 0-9, '-'.
CL0Q_NODE_ID=
# Your node's ingest token. Shown once at enrollment; it only works from the IP address you enrolled.
NODE_TOKEN=
# Where results are sent.
INGEST_URL=https://cl0q.com

# --- local database ---
# Password for the node's own Postgres (it is not reachable from outside the compose network).
DB_PASSWORD=

# --- optional ---
# Free ipinfo Lite token (https://ipinfo.io/signup) so the crawler can spread requests across hosting
# providers. Without it the crawler groups by IP address instead.
IPINFO_TOKEN=
# Concurrent page fetches. Every server still gets at most one request per second.
CRAWL_WORKERS=8

# --- advanced (all optional; politeness settings are floors and can only make a node gentler) ---
# docker-compose.yml passes only the settings above; add any of these to a service's environment to use them.
# website-crawler:
#   HOST_DELAY_MS=1000         min gap per site (never below 1000)
#   IP_DELAY_MS=1000           min gap per server IP (never below 1000)
#   ASN_MAX_PER_BATCH=20       targets per network / IP / site in one batch (1-20)
#   RECRAWL_DAYS=120           revisit a homepage at most this often (never below 120)
#   THROTTLE_RETRIES=1         retries for a 429/503 (0 or 1)
#   THROTTLE_WAIT_MAX_MS=15000 longest Retry-After waited for (0-15000)
#   ASN_BREAK_THRESHOLD=5      failures that pause a network (1-5)
#   ASN_BREAK_WINDOW_MS=60000, ASN_BACKOFF_BASE_MS=60000, ASN_BACKOFF_CAP_MS=3600000   (never below these)
#   WORKERS=16 (1-64; compose sets it from CRAWL_WORKERS), MAX_CONNS=48 (1-256), FETCH_TIMEOUT_MS=20000 (2000-60000),
#   DB_MAXCONNS=10 (1-50), DB_BATCH=200, BATCH=500, ASN_POOL_FACTOR=3,
#   EMIT_DOMAINS=1, USE_CRAWL_STATE=1, FRONTIER_SNAPSHOT=1, FRONTIER_REFRESH_S=300, FRONTIER_MAX=400000, PIPELINE=0,
#   CRAWLER_TLS_INSECURE=0     (1 skips certificate checks — not recommended)
# domain-crawler (flags, or these variables):
#   HOST_DELAY_MS=2000 (never below 2000), PER_HOST_PAGES=25 (1-25), DB_BATCH=200, QUEUE_CAP=50000, SEED_URL, SEEDS_FILE
# dns-enricher: BATCH=2000, WORKERS=16, DNS_TIMEOUT_MS=3000, DNS_RECHECK_HOURS=12, DB_MAXCONNS=4
# cl0q-node: -batch 1-2000 (flag); INGEST_URL must be https — CL0Q_NODE_ALLOW_HTTP=1 allows http for a local test only.
# SPOOL_DATABASE_URL (crawlers) is for cl0q's own deployment, whose drain job isn't part of the node build:
# leave it unset.
# asn-enricher: ASN_BATCH=1000, ASN_RPS=15 (1-50), ASN_CONCURRENCY=16 (1-16), ASN_IDLE_SEC=60, ASN_IDLE_MAX_SEC=1800,
#               ASN_RATELIMIT_BACKOFF_SEC=300, ASN_MAXCONNS=5
# run modes (all services; mainly useful for local testing):
#   LOOP=1                keep cycling instead of exiting after one batch (website-crawler default: off;
#                         dns-enricher default: on; asn-enricher loops when LOOP is set and not "0")
#   TARGET=example.com    crawl one bare domain's homepage and exit (website-crawler dev mode)
#   FRONTIER_SAMPLE_PCT=10  TABLESAMPLE percent for the frontier draw (1-100); lower = faster pool
#                         selection on huge frontiers, higher = more representative ASN mix
